#!/usr/bin/env bash
set -Eeuo pipefail

API_ENDPOINT=${CNB_API_ENDPOINT:-https://api.cnb.cool}
TOKEN=${CNB_TOKEN:?CNB_TOKEN is required}
REPO=''
TOOL=''
DATA=''
BODY=''
BODY_FILE=''
DRAFT=false
PRERELEASE=false
MAKE_LATEST=''
OVERWRITE=false

urlencode() {
  jq -nr --arg value "$1" '$value | @uri'
}

request() {
  local method=$1 path=$2 data=${3:-} response
  if [[ -n "$data" ]]; then
    response=$(curl --fail --silent --show-error --request "$method" \
      --header 'Accept: application/vnd.cnb.api+json' \
      --header "Authorization: Bearer $TOKEN" \
      --header 'Content-Type: application/json' \
      --data "$data" "$API_ENDPOINT$path")
  else
    response=$(curl --fail --silent --show-error --request "$method" \
      --header 'Accept: application/vnd.cnb.api+json' \
      --header "Authorization: Bearer $TOKEN" "$API_ENDPOINT$path")
  fi
  if [[ -n "$response" ]]; then
    jq -cn --argjson data "$response" '{status:200, data:$data}'
  else
    printf '%s\n' '{"status":204,"data":null}'
  fi
}

require_common() {
  command -v curl >/dev/null 2>&1 || { echo 'curl is required' >&2; exit 1; }
  command -v jq >/dev/null 2>&1 || { echo 'jq is required' >&2; exit 1; }
}

parse_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) REPO=$2; shift 2 ;;
      --tag) TAG=$2; shift 2 ;;
      --page-size) PAGE_SIZE=$2; shift 2 ;;
      --release-id) RELEASE_ID=$2; shift 2 ;;
      --asset-name) ASSET_NAME=$2; shift 2 ;;
      --size) SIZE=$2; shift 2 ;;
      --ttl) TTL=$2; shift 2 ;;
      --sha1) SHA1=$2; shift 2 ;;
      --upload-token) UPLOAD_TOKEN=$2; shift 2 ;;
      --asset-path) ASSET_PATH=$2; shift 2 ;;
      --tag-name) TAG_NAME=$2; shift 2 ;;
      --target-commitish) TARGET_COMMITISH=$2; shift 2 ;;
      --name) RELEASE_NAME=$2; shift 2 ;;
      --body) BODY=$2; shift 2 ;;
      --body-file) BODY_FILE=$2; shift 2 ;;
      --data) DATA=$2; shift 2 ;;
      --draft) DRAFT=true; shift ;;
      --prerelease) PRERELEASE=true; shift ;;
      --make-latest) MAKE_LATEST=$2; shift 2 ;;
      --overwrite) OVERWRITE=true; shift ;;
      --verbose) shift ;;
      --sync) shift 2 ;;
      *) shift ;;
    esac
  done
}

release_body() {
  if [[ -n "$DATA" ]]; then
    printf '%s' "$DATA"
    return
  fi
  if [[ -n "$BODY_FILE" ]]; then
    BODY=$(<"$BODY_FILE")
  fi
  jq -cn \
    --arg tag "$TAG_NAME" \
    --arg target "$TARGET_COMMITISH" \
    --arg name "${RELEASE_NAME:-$TAG_NAME}" \
    --arg body "$BODY" \
    --arg make_latest "$MAKE_LATEST" \
    --argjson draft "$DRAFT" \
    --argjson prerelease "$PRERELEASE" \
    '{tag_name:$tag,target_commitish:$target,name:$name,body:$body,draft:$draft,prerelease:$prerelease} + (if $make_latest != "" then {make_latest:$make_latest} else {} end)'
}

require_common
MODULE=${1:-}
TOOL=${2:-}
shift 2 || true
parse_options "$@"

case "$MODULE/$TOOL" in
  releases/list-releases)
    request GET "/$REPO/-/releases?page_size=${PAGE_SIZE:-10}" ;;
  releases/get-release-by-tag)
    request GET "/$REPO/-/releases/tags/$(urlencode "$TAG")" ;;
  releases/post-release)
    request POST "/$REPO/-/releases" "$(release_body)" ;;
  releases/patch-release)
    request PATCH "/$REPO/-/releases/$RELEASE_ID" "$DATA" ;;
  releases/post-release-asset-upload-url)
    upload_data=$(jq -cn --arg name "$ASSET_NAME" --argjson size "${SIZE:-0}" \
      --argjson ttl "${TTL:-0}" --argjson overwrite "$OVERWRITE" \
      '{asset_name:$name,size:$size,ttl:$ttl,overwrite:$overwrite}')
    request POST "/$REPO/-/releases/$RELEASE_ID/asset-upload-url" "$upload_data" ;;
  releases/post-release-asset-upload-confirmation)
    encoded_path=$(urlencode "$ASSET_PATH")
    request POST "/$REPO/-/releases/$RELEASE_ID/asset-upload-confirmation/$UPLOAD_TOKEN/$encoded_path?ttl=${TTL:-0}" ;;
  git/list-tags)
    request GET "/$REPO/-/git/tags?page_size=${PAGE_SIZE:-10}" ;;
  git/post-commit-asset-upload-url)
    upload_data=$(jq -cn --arg name "$ASSET_NAME" --argjson size "${SIZE:-0}" \
      --argjson ttl "${TTL:-0}" '{asset_name:$name,size:$size,ttl:$ttl}')
    request POST "/$REPO/-/git/commit-assets/$SHA1/asset-upload-url" "$upload_data" ;;
  git/post-commit-asset-upload-confirmation)
    encoded_path=$(urlencode "$ASSET_PATH")
    request POST "/$REPO/-/git/commit-assets/$SHA1/asset-upload-confirmation/$UPLOAD_TOKEN/$encoded_path?ttl=${TTL:-0}" ;;
  git/delete-tag)
    request DELETE "/$REPO/-/git/tags/$(urlencode "$TAG")" ;;
  *)
    echo "unsupported cnb command: $MODULE $TOOL" >&2
    exit 2
    ;;
esac
