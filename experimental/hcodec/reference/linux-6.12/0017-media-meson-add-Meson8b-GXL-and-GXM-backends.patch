+	if (IS_ERR(core->dos_base))
+		return PTR_ERR(core->dos_base);
+
+	core->regmap_ao =
+		syscon_regmap_lookup_by_phandle(dev->of_node,
+						"amlogic,ao-sysctrl");
+	if (IS_ERR(core->regmap_ao))
+		return dev_err_probe(dev, PTR_ERR(core->regmap_ao),
+				     "failed to get AO sysctrl\n");
+
+	core->canvas = meson_canvas_get(dev);
+	if (IS_ERR(core->canvas))
+		return dev_err_probe(dev, PTR_ERR(core->canvas),
+				     "failed to get Canvas provider\n");
+
+	core->dos_clk = devm_clk_get(dev, "dos");
+	if (IS_ERR(core->dos_clk))
+		return dev_err_probe(dev, PTR_ERR(core->dos_clk),
+				     "failed to get DOS clock\n");
+
+	core->hcodec_clk = devm_clk_get(dev, "hcodec");
+	if (IS_ERR(core->hcodec_clk))
+		return dev_err_probe(dev, PTR_ERR(core->hcodec_clk),
+				     "failed to get HCODEC clock\n");
+
+	core->irq = platform_get_irq_byname(pdev, "venc");
+	if (core->irq < 0)
+		return core->irq;
+
+	core->hw_lock = &venc->hw_lock;
+	core->dma_dev = dev;
+	core->revision = MESON_CODEC_REVISION_MESON8B;
+	venc->core = core;
+	venc->variant = device_get_match_data(dev);
+
+	return dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
