 .../platform/amlogic/meson-venc/meson-venc.c  | 480 ++++++++++++++----
 .../linux/platform_data/media/meson-codec.h   |   1 +
 4 files changed, 456 insertions(+), 117 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/media/amlogic,meson8b-hcodec.yaml

diff --git a/Documentation/devicetree/bindings/media/amlogic,meson8b-hcodec.yaml b/Documentation/devicetree/bindings/media/amlogic,meson8b-hcodec.yaml
new file mode 100644
index 0000000..ff9cbea
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/amlogic,meson8b-hcodec.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/amlogic,meson8b-hcodec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic Meson8b HCODEC video encoder
+
+maintainers:
+  - Neil Armstrong <neil.armstrong@linaro.org>
+
+description: |
+  The HCODEC block in Meson8b contains an AMRISC-assisted H.264 encoder. It
+  shares the DOS register bus and Canvas provider with other video hardware,
+  but Meson8b has no matching mainline decoder parent device.
+
+properties:
+  compatible:
+    const: amlogic,meson8b-hcodec
+
+  reg:
+    maxItems: 1
+
+  reg-names:
+    items:
+      - const: dos
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    items:
+      - const: venc
+
+  clocks:
+    maxItems: 2
+
+  clock-names:
+    items:
+      - const: dos
+      - const: hcodec
+
+  amlogic,ao-sysctrl:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the always-on power control syscon
+
+  amlogic,canvas:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the Canvas LUT provider
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - amlogic,ao-sysctrl
+  - amlogic,canvas
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/meson8b-clkc.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    video-codec@d0050000 {
+        compatible = "amlogic,meson8b-hcodec";
+        reg = <0xd0050000 0x10000>;
+        reg-names = "dos";
+        interrupts = <GIC_SPI 45 IRQ_TYPE_EDGE_RISING>;
+        interrupt-names = "venc";
+        clocks = <&clkc CLKID_DOS>, <&clkc CLKID_VDEC_HCODEC>;
+        clock-names = "dos", "hcodec";
+        amlogic,ao-sysctrl = <&pmu>;
+        amlogic,canvas = <&canvas>;
+    };
diff --git a/drivers/media/platform/amlogic/meson-venc/Kconfig b/drivers/media/platform/amlogic/meson-venc/Kconfig
index 9edaea0..3d8570e 100644
--- a/drivers/media/platform/amlogic/meson-venc/Kconfig
+++ b/drivers/media/platform/amlogic/meson-venc/Kconfig
@@ -3,15 +3,15 @@
 config VIDEO_MESON_VENC
 	tristate "Amlogic Meson H.264 encoder scaffold"
 	depends on VIDEO_DEV
-	depends on VIDEO_MESON_VDEC
+	depends on ARM || VIDEO_MESON_VDEC || COMPILE_TEST
 	depends on ARCH_MESON || COMPILE_TEST
+	select MESON_CANVAS
 	select V4L2_MEM2MEM_DEV
 	select VIDEOBUF2_DMA_CONTIG
 	help
 	  Build the V4L2 memory-to-memory encoder framework for the HCODEC
-	  block found in Amlogic Meson GXL and GXM SoCs.
+	  block found in Amlogic Meson8b, GXL and GXM SoCs. Meson8b uses a
+	  standalone DT node; GXL/GXM share the DOS owner with meson-vdec.
 
-	  The initial implementation provides format negotiation, videobuf2 queue
-	  plumbing, shared DOS arbitration, firmware loading and HCODEC lifecycle
-	  management. Encoding remains disabled until the command backend is
-	  implemented.
+	  The implementation provides NV12/YUYV to H.264 encoding through the
+	  standard V4L2 memory-to-memory API.
