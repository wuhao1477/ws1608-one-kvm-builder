+static const struct meson_venc_variant *
+meson_venc_variant_from_revision(enum meson_codec_revision revision)
+{
+	switch (revision) {
+	case MESON_CODEC_REVISION_MESON8B:
+		return &meson_venc_meson8b_variant;
+	case MESON_CODEC_REVISION_GXL:
+	case MESON_CODEC_REVISION_GXLX:
