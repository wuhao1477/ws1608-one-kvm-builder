+	ret = meson_venc_prepare_command(ctx, src, dst, 0);
+	if (ret)
+		return ret;
+	ret = meson_venc_command(ctx, MESON_VENC_CMD_SEQUENCE,
+				 MESON_VENC_STATUS_SEQUENCE_DONE);
+	if (ret)
+		return ret;
+	ret = meson_venc_command(ctx, MESON_VENC_CMD_PICTURE,
+				 MESON_VENC_STATUS_PICTURE_DONE);
+	if (ret)
