- * Amlogic Meson V4L2 memory-to-memory encoder scaffold
+ * Amlogic Meson V4L2 memory-to-memory H.264 encoder
  *
  * Copyright (C) 2026 Meson Codec contributors
  *
- * M0 deliberately contains no vendor register programming.  device_run()
- * returns buffers with an error until a reviewed HCODEC backend is
- * installed.
+ * The fixed-CQP GXL backend is derived from the register protocol used by
+ * Amlogic's GPL-2.0 Linux 4.9 encoder driver.  The userspace ABI is V4L2 M2M;
+ * no vendor character-device ABI is retained.
  */
 
 #include <linux/align.h>
@@ -48,14 +48,19 @@
