 	meson_venc_set_default_formats(ctx);
 
 	v4l2_fh_init(&ctx->fh, video_devdata(file));
@@ -1888,7 +2206,7 @@ static int meson_venc_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, venc);
 	dev_info(&pdev->dev,
-		 "registered %s with fixed-CQP GXL H.264 backend and IRQ %d\n",
