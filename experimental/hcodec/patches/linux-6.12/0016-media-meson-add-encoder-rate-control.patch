 	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
 	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
@@ -1554,6 +1864,9 @@ static void meson_venc_reset_stream_state(struct meson_venc_ctx *ctx)
 	ctx->idr_pic_id = 0;
 	ctx->recon_index = 0;
 	ctx->reference_index = 1;
