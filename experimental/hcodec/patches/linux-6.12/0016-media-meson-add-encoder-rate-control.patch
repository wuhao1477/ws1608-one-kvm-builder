+static void meson_venc_program_cbr_tables(struct meson_venc_ctx *ctx, u32 qp)
+{
+	struct meson_venc_workspace *ws = &ctx->workspace;
+	u8 *base = ws->vaddr + ws->cbr_offset;
+	unsigned int i;
+
+	/* The full GXL microcode selects macroblock QP and mode costs from
+	 * sixteen 128-byte tables. Leaving this workspace zeroed silently forces
+	 * QP 0 even when the slice header advertises another value.
+	 */
+	for (i = 0; i < MESON_VENC_CBR_TABLE_COUNT; i++) {
+		u8 *table = base + i * MESON_VENC_CBR_TABLE_STRIDE;
+		u16 *weight = (u16 *)(table + 96);
+		u16 step = i >= 13 ? i - 13 : 0;
+
+		memset(table, qp, 96);
+		weight[0] = 0x655 + step * 0x380;
+		weight[1] = 0x560;
+		weight[2] = 0x520 + step * 0x200;
+		weight[3] = 0x675 + step * 0x480;
+		weight[4] = 0x570 + step * 0x200;
+		weight[5] = 0x530 + step * 0x280;
+		weight[6] = 0x55aa;
+		weight[7] = 0xaa55;
+	}
+
+	/* No previous-frame spatial weighting is available to the V4L2 backend
+	 * yet. 0xffff matches the BSP's uniform first-frame budget.
+	 */
+	memset(base + MESON_VENC_CBR_TABLE_SIZE, 0xff,
+	       MESON_VENC_CBR_SIZE - MESON_VENC_CBR_TABLE_SIZE);
+}
+
 static void meson_venc_program_mfdin(struct meson_venc_ctx *ctx)
 {
 	struct meson_venc_workspace *ws = &ctx->workspace;
