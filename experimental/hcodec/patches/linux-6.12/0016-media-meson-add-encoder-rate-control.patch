 		break;
 	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
 		WRITE_ONCE(ctx->force_keyframe, true);
@@ -1258,7 +1511,7 @@ static int meson_venc_ctrls_init(struct meson_venc_ctx *ctx)
 {
