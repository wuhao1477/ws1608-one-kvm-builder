 	return ret;
 }
 
+static int meson_venc_append_filler(struct vb2_v4l2_buffer *dst,
+				    size_t offset, size_t length)
+{
+	struct dma_buf *dbuf = dst->vb2_buf.planes[0].dbuf;
+	u8 *data;
+	int ret = 0;
+
+	if (length < MESON_VENC_FILLER_MIN_SIZE)
+		return -EINVAL;
+
+	if (dbuf) {
+		ret = dma_buf_begin_cpu_access(dbuf, DMA_BIDIRECTIONAL);
+		if (ret)
+			return ret;
+	}
+
+	data = vb2_plane_vaddr(&dst->vb2_buf, 0);
+	if (!data) {
+		ret = -EFAULT;
+	} else {
+		data += offset;
+		data[0] = 0;
+		data[1] = 0;
+		data[2] = 0;
+		data[3] = 1;
+		data[4] = 12;
+		memset(data + 5, 0xff, length - 6);
+		data[length - 1] = 0x80;
+	}
+
+	if (dbuf) {
+		int end_ret;
+
+		end_ret = dma_buf_end_cpu_access(dbuf, DMA_BIDIRECTIONAL);
+		if (!ret)
+			ret = end_ret;
+	}
+
+	return ret;
+}
+
+static bool meson_venc_rate_control_active(struct meson_venc_ctx *ctx)
+{
+	return READ_ONCE(ctx->frame_rc_enable) &&
+	       READ_ONCE(ctx->bitrate_mode) !=
+		V4L2_MPEG_VIDEO_BITRATE_MODE_CQ;
+}
+
+static u64 meson_venc_target_bits(struct meson_venc_ctx *ctx, u32 bitrate)
+{
+	u32 frame_rate = max_t(u32, READ_ONCE(ctx->frame_rate), 1);
+
+	return max_t(u64, div_u64(bitrate, frame_rate), 8);
+}
+
+static void meson_venc_rate_control_reset(struct meson_venc_ctx *ctx)
+{
+	ctx->rc_bucket_bits = 0;
+	ctx->rc_actual_bits = 0;
+	ctx->rc_frames = 0;
+}
+
+static void meson_venc_rate_control_begin(struct meson_venc_ctx *ctx,
+					  bool keyframe)
+{
+	if (atomic_xchg(&ctx->rc_reset_pending, 0))
+		meson_venc_rate_control_reset(ctx);
+
+	if (meson_venc_rate_control_active(ctx))
+		ctx->active_qp = ctx->rc_qp;
+	else
+		ctx->active_qp = keyframe ? READ_ONCE(ctx->i_qp) :
+			READ_ONCE(ctx->p_qp);
+}
+
+static void meson_venc_rc_update_qp(struct meson_venc_ctx *ctx, u64 real_bits,
+				    u64 target_bits, u64 peak_bits,
+				    bool keyframe)
+{
+	s64 bucket_limit;
+	s64 error;
+	u64 qp_target = keyframe ? target_bits * 4 : target_bits;
+	int delta = 0;
+
+	error = (s64)real_bits - (s64)target_bits;
+	bucket_limit = (s64)target_bits *
+		max_t(u32, READ_ONCE(ctx->frame_rate), 1) * 2;
+	ctx->rc_bucket_bits += error;
+	if (ctx->rc_bucket_bits > bucket_limit)
+		ctx->rc_bucket_bits = bucket_limit;
+	else if (ctx->rc_bucket_bits < -bucket_limit)
+		ctx->rc_bucket_bits = -bucket_limit;
+
+	if (real_bits > qp_target * 8)
+		delta = 8;
+	else if (real_bits > qp_target * 4)
+		delta = 6;
+	else if (real_bits > qp_target * 2)
+		delta = 4;
+	else if (real_bits * 4 > qp_target * 5)
+		delta = 2;
+	else if (real_bits * 8 > qp_target * 9)
+		delta = 1;
+	else if (real_bits * 8 < qp_target)
+		delta = -6;
+	else if (real_bits * 4 < qp_target)
+		delta = -4;
+	else if (real_bits * 2 < qp_target)
+		delta = -2;
+	else if (real_bits * 8 < qp_target * 7)
+		delta = -1;
+
+	if (real_bits > peak_bits && delta < 4)
+		delta = 4;
+	if (ctx->rc_bucket_bits > (s64)target_bits * 8)
+		delta++;
+	else if (ctx->rc_bucket_bits < -(s64)target_bits * 8)
+		delta--;
+
+	ctx->rc_qp = clamp_t(int, (int)ctx->rc_qp + delta, 0, 51);
+}
+
+static int meson_venc_rate_control_finish(struct meson_venc_ctx *ctx,
+					  struct vb2_v4l2_buffer *dst,
+					  size_t *payload, bool keyframe)
+{
+	u32 bitrate;
+	u32 peak_bitrate;
+	u32 mode;
+	u64 target_bits;
+	u64 peak_bits;
+	u64 real_bits;
+	u64 desired_bits;
+	u64 projected_bits;
+	u64 deficit_bits;
+	size_t dst_size;
+	size_t filler = 0;
+	int ret;
+
+	if (!meson_venc_rate_control_active(ctx))
+		return 0;
+
+	bitrate = READ_ONCE(ctx->bitrate);
+	peak_bitrate = max_t(u32, READ_ONCE(ctx->peak_bitrate), bitrate);
+	mode = READ_ONCE(ctx->bitrate_mode);
+	target_bits = meson_venc_target_bits(ctx, bitrate);
+	peak_bits = meson_venc_target_bits(ctx, peak_bitrate);
+	real_bits = (u64)*payload * 8;
+
+	meson_venc_rc_update_qp(ctx, real_bits, target_bits, peak_bits,
+				keyframe);
+
+	if (mode == V4L2_MPEG_VIDEO_BITRATE_MODE_CBR) {
+		desired_bits = div_u64((ctx->rc_frames + 1) *
+					(u64)bitrate,
+					max_t(u32, READ_ONCE(ctx->frame_rate), 1));
+		projected_bits = ctx->rc_actual_bits + real_bits;
+		if (desired_bits > projected_bits) {
+			deficit_bits = desired_bits - projected_bits;
+			filler = div_u64(deficit_bits + 4, 8);
+			dst_size = vb2_plane_size(&dst->vb2_buf, 0);
+			filler = min_t(size_t, filler, dst_size - *payload);
+			if (filler < MESON_VENC_FILLER_MIN_SIZE)
+				filler = 0;
+		}
+	}
+
+	if (filler) {
+		ret = meson_venc_append_filler(dst, *payload, filler);
+		if (ret)
+			return ret;
+		*payload += filler;
+	}
+
+	ctx->rc_actual_bits += (u64)*payload * 8;
+	ctx->rc_frames++;
+	return 0;
+}
+
 static void meson_venc_advance_reference(struct meson_venc_ctx *ctx, bool idr)
