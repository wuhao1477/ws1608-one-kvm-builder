+			  V4L2_CID_MPEG_VIDEO_BITRATE_PEAK,
+			  MESON_VENC_MIN_BITRATE, MESON_VENC_MAX_BITRATE,
+			  1000, MESON_VENC_DEFAULT_PEAK_BITRATE);
+	v4l2_ctrl_new_std(handler, &meson_venc_ctrl_ops,
+			  V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE,
+			  0, 1, 1, 1);
 	v4l2_ctrl_new_std(handler, &meson_venc_ctrl_ops,
 			  V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME, 0, 0, 0, 0);
 	v4l2_ctrl_new_std_menu(handler, NULL,
@@ -1452,6 +1720,46 @@ static int meson_venc_s_fmt(struct file *file, void *priv,
 	return 0;
 }
 
+static int meson_venc_g_parm(struct file *file, void *priv,
+			     struct v4l2_streamparm *parm)
+{
+	struct meson_venc_ctx *ctx = fh_to_ctx(priv);
+	struct v4l2_outputparm *output = &parm->parm.output;
+
+	if (parm->type != V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		return -EINVAL;
+
+	memset(output, 0, sizeof(*output));
+	output->capability = V4L2_CAP_TIMEPERFRAME;
+	output->timeperframe.numerator = 1;
+	output->timeperframe.denominator = READ_ONCE(ctx->frame_rate);
+	return 0;
+}
+
+static int meson_venc_s_parm(struct file *file, void *priv,
+			     struct v4l2_streamparm *parm)
+{
+	struct meson_venc_ctx *ctx = fh_to_ctx(priv);
+	struct v4l2_fract *timeperframe =
+		&parm->parm.output.timeperframe;
+	u32 frame_rate;
+
+	if (parm->type != V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		return -EINVAL;
+
+	if (!timeperframe->numerator || !timeperframe->denominator) {
+		frame_rate = MESON_VENC_DEFAULT_FPS;
+	} else {
+		frame_rate = DIV_ROUND_CLOSEST(timeperframe->denominator,
+					       timeperframe->numerator);
+		frame_rate = clamp_t(u32, frame_rate, 1, MESON_VENC_MAX_FPS);
+	}
+	WRITE_ONCE(ctx->frame_rate, frame_rate);
+	atomic_set(&ctx->rc_reset_pending, 1);
+
+	return meson_venc_g_parm(file, priv, parm);
+}
+
 static int meson_venc_subscribe_event(struct v4l2_fh *fh,
 				      const struct v4l2_event_subscription *sub)
