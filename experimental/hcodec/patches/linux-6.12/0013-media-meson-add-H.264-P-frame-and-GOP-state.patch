 #define HCODEC_HDEC_MC_OMEM_AUTO	0x64c0
@@ -185,9 +189,11 @@ enum meson_venc_command {
 	MESON_VENC_CMD_SEQUENCE = 1,
 	MESON_VENC_CMD_PICTURE = 2,
 	MESON_VENC_CMD_IDR = 3,
+	MESON_VENC_CMD_NON_IDR = 4,
 	MESON_VENC_STATUS_SEQUENCE_DONE = 7,
 	MESON_VENC_STATUS_PICTURE_DONE = 8,
 	MESON_VENC_STATUS_IDR_DONE = 9,
+	MESON_VENC_STATUS_NON_IDR_DONE = 10,
 	MESON_VENC_STATUS_ERROR = 0xff,
 };
 
@@ -238,6 +244,7 @@ struct meson_venc_dev {
 	/* Serializes video-device ioctls and device removal. */
