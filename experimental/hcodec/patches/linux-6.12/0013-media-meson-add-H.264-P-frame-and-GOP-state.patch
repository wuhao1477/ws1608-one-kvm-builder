 	struct v4l2_fh fh;
+	struct v4l2_ctrl_handler ctrl_handler;
 	struct meson_venc_q_data q_data[MESON_VENC_QUEUE_COUNT];
 	struct meson_venc_workspace workspace;
+	u32 gop_size;
+	u32 i_qp;
+	u32 p_qp;
+	u32 frame_count;
+	u32 frame_number;
+	u32 pic_order_cnt_lsb;
+	u32 idr_pic_id;
+	u8 recon_index;
