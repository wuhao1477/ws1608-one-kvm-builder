+	struct media_device mdev;
 	struct video_device vdev;
 	struct v4l2_m2m_dev *m2m_dev;
 	struct completion irq_done;
@@ -250,12 +257,23 @@ struct meson_venc_ctx {
 	/* Serializes the two vb2 queues belonging to this context. */
