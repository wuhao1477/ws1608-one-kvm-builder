+#define MESON_VENC_DEFAULT_GOP	30U
+#define MESON_VENC_MAX_GOP	300U
 #define MESON_VENC_CMD_TIMEOUT_MS	2000U
 
 #define AO_RTI_GEN_PWR_SLEEP0	0xe8
@@ -101,6 +104,7 @@
 #define HCODEC_HENC_SCRATCH_G		0x6b40
 #define HCODEC_HENC_SCRATCH_I		0x6b48
 #define HCODEC_HENC_SCRATCH_J		0x6b4c
+#define HCODEC_HENC_SCRATCH_K		0x6b50
 #define HCODEC_HENC_SCRATCH_L		0x6b54
