From 5d4f2d3c9f7e8b6a5c4d3e2f1a0b9c8d7e6f5a4b Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 9 Sep 2026 15:00:00 +0800
Subject: [PATCH] media: meson: defer Meson8b power-off after streamoff

The WS1608 completes the H.264 streamoff sequence, then loses network
reachability while the Meson8b power-off sequence runs after userspace exits.
Defer that destructive transition for the Meson8b one-shot candidate and
clean it up when the driver is removed. Stop the Meson8b HCODEC CPU before
releasing stream buffers, then leave only the destructive power transition
deferred. A second encode in the same boot is rejected because the hardware
remains powered until reboot or removal.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/media/platform/amlogic/meson-venc/meson-venc.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/amlogic/meson-venc/meson-venc.c b/drivers/media/platform/amlogic/meson-venc/meson-venc.c
index 5e4a1b9..b2f6e7c 100644
--- a/drivers/media/platform/amlogic/meson-venc/meson-venc.c
+++ b/drivers/media/platform/amlogic/meson-venc/meson-venc.c
@@ -2101,10 +2101,15 @@ static int meson_venc_start_streaming(struct vb2_queue *vq,
 	if (!ctx->owns_hw) {
 		if (!mutex_trylock(ctx->venc->core->hw_lock)) {
 			while ((vbuf = V4L2_TYPE_IS_OUTPUT(vq->type) ?
 				v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
 				v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx)))
 				v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_QUEUED);
 			return -EBUSY;
 		}
+		if (ctx->venc->variant->full_power_reset &&
+		    ctx->venc->powered) {
+			mutex_unlock(ctx->venc->core->hw_lock);
+			return -EBUSY;
+		}
 		ctx->owns_hw = true;
 		meson_venc_reset_stream_state(ctx);
@@ -2167,5 +2175,9 @@ static void meson_venc_stop_streaming(struct vb2_queue *vq)
 	if (ctx->owns_hw && !ctx->streaming_output &&
 	    !ctx->streaming_capture) {
-		meson_venc_power_off(ctx->venc);
+		if (ctx->venc->variant->full_power_reset)
+			meson_venc_stop_cpu(ctx->venc);
+		if (ctx->venc->variant->full_power_reset)
+			meson_venc_trace_runtime(ctx->venc,
+						"stop_streaming: power_off deferred");
+		else
+			meson_venc_power_off(ctx->venc);
 		meson_venc_workspace_free(ctx);
 		ctx->owns_hw = false;
@@ -2550,4 +2563,7 @@ static void meson_venc_remove(struct platform_device *pdev)
 	media_device_cleanup(&venc->mdev);
 	video_unregister_device(&venc->vdev);
+	mutex_lock(venc->core->hw_lock);
+	meson_venc_power_off(venc);
+	mutex_unlock(venc->core->hw_lock);
 	v4l2_m2m_release(venc->m2m_dev);
 	v4l2_device_unregister(&venc->v4l2_dev);
-- 
2.50.0
