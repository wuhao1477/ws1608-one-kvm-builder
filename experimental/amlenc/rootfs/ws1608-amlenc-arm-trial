#!/usr/bin/env bash
set -Eeuo pipefail

BOOT_DIR=${BOOT_DIR:-/boot}
UNAME_RELEASE=${UNAME_RELEASE-$(uname -r)}
IP_OUTPUT=${IP_OUTPUT-$(ip -4 -o addr show scope global)}
SSHD_ACTIVE=${SSHD_ACTIVE-$(pgrep -x sshd >/dev/null && echo true || echo false)}
ROOT_MOUNT_OPTIONS=${ROOT_MOUNT_OPTIONS-$(findmnt -no OPTIONS /)}

fail() { echo "cannot arm legacy trial: $*" >&2; exit 1; }
[[ "$UNAME_RELEASE" == 6.12.28-current-meson ]] || fail "recovery kernel is not active"
[[ "$IP_OUTPUT" == *' inet '* ]] || fail "no global IPv4 address"
[[ "$SSHD_ACTIVE" == true ]] || fail "sshd is not active"
[[ ",$ROOT_MOUNT_OPTIONS," == *,rw,* ]] || fail "root filesystem is not read-write"
[[ -d "$BOOT_DIR" && ! -L "$BOOT_DIR" && -w "$BOOT_DIR" ]] || fail "boot filesystem is unsafe"
force_marker="$BOOT_DIR/amlenc-force-recovery"
armed_marker="$BOOT_DIR/amlenc-legacy-trial-armed"
[[ -f "$force_marker" && ! -L "$force_marker" && -s "$force_marker" ]] || fail "recovery marker is missing"

temporary="$BOOT_DIR/.amlenc-legacy-trial-armed.tmp"
printf 'kernel=%s\n' "$UNAME_RELEASE" >"$temporary"
chmod 0644 "$temporary"
sync
mv -f -- "$temporary" "$armed_marker"
sync
rm -f -- "$force_marker"
sync
echo "armed one Linux 3.10.107 trial; reboot to continue"
