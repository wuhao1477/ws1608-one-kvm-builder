+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * WS1608/S805 AMLENC research boundary for Linux 6.12.
+ *
+ * The vendor userspace ABI expects /dev/amvenc_avc. This boundary does not
+ * create that node and deliberately refuses probe until the hardware resource
+ * and ioctl contracts have independent tests.
+ */
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define MESON8B_AMLENC_VENDOR_NODE "amvenc_avc"
+
+static int meson8b_amlenc_research_probe(struct platform_device *pdev)
+{
+	dev_warn(&pdev->dev,
+		 "research boundary only; %s is not registered\n",
+		 MESON8B_AMLENC_VENDOR_NODE);
+	return -ENODEV;
+}
+
+static const struct of_device_id meson8b_amlenc_research_of_match[] = {
+	{ .compatible = "amlogic,meson8b-amvenc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, meson8b_amlenc_research_of_match);
+
+static struct platform_driver meson8b_amlenc_research_driver = {
+	.probe = meson8b_amlenc_research_probe,
+	.driver = {
+		.name = "meson8b-amlenc-research",
+		.of_match_table = meson8b_amlenc_research_of_match,
+	},
+};
+module_platform_driver(meson8b_amlenc_research_driver);
+
+MODULE_DESCRIPTION("Meson8b AMLENC Linux 6.12 research boundary");
+MODULE_AUTHOR("WS1608 One-KVM Builder contributors");
+MODULE_LICENSE("GPL");
