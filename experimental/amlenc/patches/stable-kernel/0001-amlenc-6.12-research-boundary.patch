+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MESON8B_AMLENC_RESEARCH
+	tristate "Meson8b AMLENC research boundary"
+	depends on ARCH_MESON || COMPILE_TEST
+	depends on OF
+	default n
+	help
+	  Build a non-functional probe boundary for the Meson8b/S805 H.264
+	  encoder. It does not register /dev/amvenc_avc or issue vendor
+	  ioctls. Keep this disabled until the reserved-memory, clock, reset,
+	  canvas and firmware contracts have been ported and tested on the
+	  6.12.28-current-meson kernel used by the verified WS1608 image.
