diff --git a/src/video/codec/software_self_check.rs b/src/video/codec/software_self_check.rs
new file mode 100644
index 0000000..b89faff
--- /dev/null
+++ b/src/video/codec/software_self_check.rs
@@ -0,0 +1,255 @@
+use hwcodec::{
+    common::{Quality, RateControl},
+    ffmpeg::{resolve_pixel_format, AVPixelFormat},
+    ffmpeg_ram::{
+        decode::{DecodeContext, Decoder},
+        encode::{EncodeContext, Encoder as HwEncoder},
+        has_encoder,
+    },
+};
+use serde::Serialize;
+use std::{
+    sync::mpsc,
+    time::{Duration, Instant},
+};
+
+const SOFTWARE_SELF_CHECK_WIDTH: u32 = 320;
+const SOFTWARE_SELF_CHECK_HEIGHT: u32 = 240;
+const SOFTWARE_SELF_CHECK_FPS: u32 = 10;
+const SOFTWARE_SELF_CHECK_FRAME_COUNT: u32 = 10;
+const SOFTWARE_SELF_CHECK_TIMEOUT: Duration = Duration::from_secs(5);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CodecSelfCheckBackend {
+    Software,
+    Hardware,
+}
+
+impl CodecSelfCheckBackend {
+    pub const fn id(self) -> &'static str {
+        match self {
+            Self::Software => "software",
+            Self::Hardware => "hardware",
+        }
+    }
+}
+
+#[derive(Serialize)]
+pub struct SoftwareCodecSelfCheckCell {
+    pub codec_id: &'static str,
+    pub encoder: &'static str,
+    pub decoder: &'static str,
+    pub backend: &'static str,
+    pub submitted_frames: u32,
+    pub decoded_frames: u32,
+    pub keyframe: bool,
+    pub ok: bool,
+    pub elapsed_ms: u64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub error: Option<&'static str>,
+}
+
+#[derive(Serialize)]
+pub struct SoftwareCodecSelfCheckRow {
+    pub resolution_id: &'static str,
+    pub width: u32,
+    pub height: u32,
+    pub cells: Vec<SoftwareCodecSelfCheckCell>,
+}
+
+#[derive(Serialize)]
+pub struct SoftwareCodecSelfCheckResponse {
+    pub backend: &'static str,
+    pub rows: Vec<SoftwareCodecSelfCheckRow>,
+}
+
+impl SoftwareCodecSelfCheckResponse {
+    pub fn all_passed(&self) -> bool {
+        self.rows
+            .iter()
+            .flat_map(|row| &row.cells)
+            .all(|cell| cell.ok)
+    }
+}
+
+#[derive(Clone, Copy)]
+struct SoftwareCodecSpec {
+    id: &'static str,
+    encoder: &'static str,
+    decoder: &'static str,
+}
+
+const SOFTWARE_CODECS: [SoftwareCodecSpec; 4] = [
+    SoftwareCodecSpec {
+        id: "h264",
+        encoder: "libx264",
+        decoder: "h264",
+    },
+    SoftwareCodecSpec {
+        id: "h265",
+        encoder: "libx265",
+        decoder: "hevc",
+    },
+    SoftwareCodecSpec {
+        id: "vp8",
+        encoder: "libvpx_vp8",
+        decoder: "vp8",
+    },
+    SoftwareCodecSpec {
+        id: "vp9",
+        encoder: "libvpx_vp9",
+        decoder: "vp9",
+    },
+];
+
+pub fn run_codec_self_check(backend: CodecSelfCheckBackend) -> SoftwareCodecSelfCheckResponse {
+    let cells = SOFTWARE_CODECS
+        .into_iter()
+        .map(|codec| run_single_codec(codec, backend))
+        .collect();
+    SoftwareCodecSelfCheckResponse {
+        backend: backend.id(),
+        rows: vec![SoftwareCodecSelfCheckRow {
+            resolution_id: "320p",
+            width: SOFTWARE_SELF_CHECK_WIDTH,
+            height: SOFTWARE_SELF_CHECK_HEIGHT,
+            cells,
+        }],
+    }
+}
+
+fn run_single_codec(
+    spec: SoftwareCodecSpec,
+    backend: CodecSelfCheckBackend,
+) -> SoftwareCodecSelfCheckCell {
+    let started = Instant::now();
+    if backend != CodecSelfCheckBackend::Software {
+        return failed_cell(spec, backend, started, "hardware_self_check_not_supported");
+    }
+    if !has_encoder(spec.encoder) {
+        return failed_cell(spec, backend, started, "encoder_unavailable");
+    }
+    let (sender, receiver) = mpsc::channel();
+    let _ = std::thread::Builder::new()
+        .name(format!("software-codec-self-check-{}", spec.id))
+        .spawn(move || {
+            let _ = sender.send(run_software_codec(spec));
+        });
+    match receiver.recv_timeout(SOFTWARE_SELF_CHECK_TIMEOUT) {
+        Ok(Ok(metrics)) => successful_cell(spec, backend, started, metrics),
+        Ok(Err(error)) => failed_cell(spec, backend, started, error),
+        Err(_) => failed_cell(spec, backend, started, "self_check_timeout"),
+    }
+}
+
+struct Metrics {
+    decoded_frames: u32,
+    keyframe: bool,
+}
+
+fn run_software_codec(spec: SoftwareCodecSpec) -> Result<Metrics, &'static str> {
+    let mut encoder = HwEncoder::new(EncodeContext {
+        name: spec.encoder.to_string(),
+        width: SOFTWARE_SELF_CHECK_WIDTH as i32,
+        height: SOFTWARE_SELF_CHECK_HEIGHT as i32,
+        pixfmt: resolve_pixel_format("yuv420p", AVPixelFormat::AV_PIX_FMT_YUV420P),
+        align: 1,
+        fps: SOFTWARE_SELF_CHECK_FPS as i32,
+        gop: SOFTWARE_SELF_CHECK_FRAME_COUNT as i32,
+        rc: RateControl::RC_CBR,
+        quality: Quality::Quality_Low,
+        kbs: 400,
+        q: 23,
+        thread_count: 1,
+    })
+    .map_err(|_| "encoder_initialization_failed")?;
+    let mut decoder = Decoder::new(DecodeContext {
+        name: spec.decoder.to_string(),
+        width: SOFTWARE_SELF_CHECK_WIDTH as i32,
+        height: SOFTWARE_SELF_CHECK_HEIGHT as i32,
+        sw_pixfmt: AVPixelFormat::AV_PIX_FMT_YUV420P,
+        thread_count: 1,
+    })
+    .map_err(|_| "decoder_initialization_failed")?;
+    let frame = build_yuv420p_test_frame(encoder.length as usize);
+    encoder.request_keyframe();
+    let mut decoded_frames = 0;
+    let mut keyframe = false;
+    for sequence in 0..SOFTWARE_SELF_CHECK_FRAME_COUNT {
+        let packets = encoder
+            .encode(&frame, i64::from(sequence * 100))
+            .map_err(|_| "encode_failed")?;
+        if packets.is_empty() {
+            return Err("empty_output");
+        }
+        for packet in packets.iter() {
+            if packet.data.is_empty() {
+                return Err("empty_output");
+            }
+            keyframe |= packet.key != 0;
+            decoded_frames += decoder
+                .decode(&packet.data)
+                .map_err(|_| "decode_failed")?
+                .len() as u32;
+        }
+    }
+    if !keyframe {
+        return Err("keyframe_missing");
+    }
+    if decoded_frames != SOFTWARE_SELF_CHECK_FRAME_COUNT {
+        return Err("frame_count_mismatch");
+    }
+    Ok(Metrics {
+        decoded_frames,
+        keyframe,
+    })
+}
+
+fn build_yuv420p_test_frame(length: usize) -> Vec<u8> {
+    let y_len = (SOFTWARE_SELF_CHECK_WIDTH * SOFTWARE_SELF_CHECK_HEIGHT) as usize;
+    let mut frame = vec![0x80; length.max(y_len * 3 / 2)];
+    for (index, pixel) in frame[..y_len].iter_mut().enumerate() {
+        *pixel = 16 + (index % 200) as u8;
+    }
+    frame
+}
+
+fn successful_cell(
+    spec: SoftwareCodecSpec,
+    backend: CodecSelfCheckBackend,
+    started: Instant,
+    metrics: Metrics,
+) -> SoftwareCodecSelfCheckCell {
+    SoftwareCodecSelfCheckCell {
+        codec_id: spec.id,
+        encoder: spec.encoder,
+        decoder: spec.decoder,
+        backend: backend.id(),
+        submitted_frames: SOFTWARE_SELF_CHECK_FRAME_COUNT,
+        decoded_frames: metrics.decoded_frames,
+        keyframe: metrics.keyframe,
+        ok: true,
+        elapsed_ms: started.elapsed().as_millis() as u64,
+        error: None,
+    }
+}
+
+fn failed_cell(
+    spec: SoftwareCodecSpec,
+    backend: CodecSelfCheckBackend,
+    started: Instant,
+    error: &'static str,
+) -> SoftwareCodecSelfCheckCell {
+    SoftwareCodecSelfCheckCell {
+        codec_id: spec.id,
+        encoder: spec.encoder,
+        decoder: spec.decoder,
+        backend: backend.id(),
+        submitted_frames: SOFTWARE_SELF_CHECK_FRAME_COUNT,
+        decoded_frames: 0,
+        keyframe: false,
+        ok: false,
+        elapsed_ms: started.elapsed().as_millis() as u64,
+        error: Some(error),
+    }
+}
