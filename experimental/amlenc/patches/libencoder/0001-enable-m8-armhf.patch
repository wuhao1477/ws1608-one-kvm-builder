 	@echo " [CXX] $<"
 	@$(CXX) -c $(CFLAGS) $(INC) $< -o $@
 
+%.o: %.s
+	@echo " [ASM] $<"
+	@$(CC) -c $(CFLAGS) $< -o $@
+
