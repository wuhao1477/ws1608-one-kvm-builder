+    memset(&params, 0, sizeof(params));
+    params.width = width;
+    params.height = height;
+    params.frame_rate = frame_rate;
+    params.bit_rate = bit_rate;
+    params.gop = gop;
+    params.csc = ENC_CSC_BT709;
+    params.profile = ENC_AVC_MAIN;
+    params.level = ENC_AVC_LEVEL4;
+    return vendor_video_encoder_init(codec_id, params);
